  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
